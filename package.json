{
  "name": "adaptive-speech-rate",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first adaptive speech-rate controller for YouTube learning videos.",
  "license": "MIT",
  "keywords": [
    "browser-extension",
    "speech-rate",
    "youtube"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --import tsx tools/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "simulate": "node --import tsx tools/controller-simulator/index.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
